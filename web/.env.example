# PostgreSQL connection string for the environment being run.
DATABASE_URL=

# Generate independent values for each environment, for example:
#   openssl rand -base64 32
AUTH_SECRET=

# Local development URL. In Vercel, set this to the canonical HTTPS deployment URL.
NEXTAUTH_URL=http://localhost:3000

# A separate, high-entropy secret used to HMAC device tokens before storage.
AGENT_TOKEN_PEPPER=
